# Puerto del servidor
PORT=3000

# API Key de OpenAI
OPENAI_API_KEY=tu_openai_api_key_aqui

# API Token permanente de WhatsApp de Meta Cloud
WHATSAPP_TOKEN=tu_whatsapp_token_de_meta_aqui

# ID de número de teléfono de WhatsApp (Meta App Dashboard)
PHONE_NUMBER_ID=1224186667440867

# Token de verificación secreto (cualquier palabra configurada en Meta Webhook)
VERIFY_TOKEN=mi_token_secreto_123

# Numeros destino permanentes para enviar las ordenes generadas.
# Formato: Nombre:Numero,Nombre2:Numero2
# Si el numero no empieza con 591, el servidor le agrega +591 automaticamente.
DEFAULT_RECIPIENTS=Compras:71030013,Administracion:63482090

# Numero activo por defecto. Puede ir con o sin +591.
DEFAULT_ACTIVE_RECIPIENT=71030013

# Tiempo maximo del proceso JavaScript antes de cancelarlo automaticamente.
PROCESS_TIMEOUT_MS=240000

# Usa OpenAI Vision para identificar proveedor/representante desde texto e imagen.
# Sirve para casos como logos donde el texto directo no dice el nombre comercial.
OPENAI_VENDOR_ANALYSIS=true
OPENAI_VENDOR_MODEL=gpt-4o-mini
